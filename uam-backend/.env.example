# uam-backend/.env.example — template (committed)
# Docker: dev/.env.dev holds MONGODB_URI + shared secrets.
# Standalone npm run dev: also copy secrets into uam-backend/.env.dev

PORT=8080
NODE_ENV=development

# Set in dev/.env.dev (Atlas) or local mongo profile:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uam?retryWrites=true&w=majority&appName=uam-backend

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=CHANGE_ME_must_match_gateway_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ISSUER=api-gateway-auth-server
JWT_AUDIENCE=api-gateway-clients

PASSWORD_PEPPER=CHANGE_ME_pepper
ADMIN_API_KEY=CHANGE_ME_admin_key
AUTO_VERIFY_EMAIL=true
COOKIE_SECURE=false

CLIENT_URL=http://localhost:8091
CONTROL_PLANE_URL=http://control-plane:8081

# OAuth / SMTP — prefer dev/.env.dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
